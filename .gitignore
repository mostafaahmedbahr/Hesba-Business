**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/build/
/android/app/debug
/android/app/profile
/android/app/release

# Node (Firestore rules tests live in rules_tests/)
node_modules/

# Release signing keys — NEVER commit. The upload key is configured through
# android/key.properties (gitignored in android/.gitignore). If a key is ever
# committed, treat it as compromised: rotate it via Play App Signing and purge
# it from Git history. These root-level patterns stop copies placed at the repo
# root from being tracked (android/.gitignore only covers android/).
*.keystore
*.jks
