rules_version = '2';

// Firestore security rules for Hesba — PRODUCTION version.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore > Rules)
//
// Principles:
//  1. No catch-all: every collection is scoped explicitly. Default deny.
//  2. Shop isolation: a signed-in user touches only docs of their own shop
//     (ownerId match) or a shop they belong to (users/{uid}.shopId match,
//     so manager/cashier accounts of the same shop keep working).
//  3. Subscription enforcement is server-side, not just UI: creating,
//     updating or deleting business data (products/sales/expenses/returns)
//     requires a live trial/active subscription whose endDate is in the
//     future. Reads stay open (expired users can still VIEW their data).
//  4. Roles cannot be self-granted: `role` on users/{uid} can only change
//     via an existing admin (console). Owners keep `role` untouched.
//  5. Admin writes (approve/reject, dashboard mirrors, settings, activity)
//     are allowed through the `isAdmin()` check, so the Admin app works
//     with these rules deployed (the old draft blocked admin updates).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    function isAdmin() {
      return signedIn() && myUserDoc().get('role', '') == 'admin';
    }

    function myShopId() {
      return myUserDoc().get('shopId', '');
    }

    // Same shop: owner match, or a coworker account of the same shop.
    function sameShop(shopId) {
      return shopId != null && shopId != '' &&
        (myShopId() == shopId);
    }

    function unchangedRole() {
      return request.resource.data.get('role', null) ==
        resource.data.get('role', null);
    }

    // Owner-editable profile fields (updateProfile + FCM token only).
    // Anything else on users/{uid} (shopId, email, createdAt, …) is
    // admin-only, so a compromised client cannot escalate or reassign shops.
    function onlyOwnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['ownerName', 'phone', 'shopName', 'businessType',
          'shopPhone', 'address', 'state', 'city', 'shopImageUrl',
          'updatedAt', 'locationUrl', 'latitude', 'longitude',
          'locationAddress', 'fcmTokens', 'fcmTokensUpdatedAt']);
    }

    // Optional numeric field that, when present, must be a number >= 0.
    // Tolerant of partial updates; blocks negative-money injection.
    function nonNegative(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number
          && request.resource.data[field] >= 0);
    }

    // Products: price is required and positive; everything else numeric
    // must stay >= 0 (stock 0 = out of stock is legitimate).
    function validProduct() {
      return request.resource.data.price is number
        && request.resource.data.price > 0
        && nonNegative('costPrice')
        && nonNegative('stock')
        && nonNegative('lowStockThreshold');
    }

    // Optional string field that, when present (and non-null), must be a
    // string no longer than `maxLen`. Used by the supplier document.
    function optionalString(d, key, maxLen) {
      let v = d.get(key, null);
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Suppliers: full-document structure check (create + update).
    //  - id / ownerId / shopId are set once by a signed-in user of the
    //    shop they belong to (never another shop's supplier).
    //  - name + phone are required non-empty strings; phone is 7..30 of
    //    dialable characters (Latin + Arabic-Indic digits, + ( ) - space).
    //  - every other field is optional but must be a bounded string.
    function validSupplier(docId) {
      let d = request.resource.data;
      return d.get('id', null) == docId
        && d.get('ownerId', null) == myUid()
        && d.get('shopId', null) == myShopId()
        && d.get('name', null) is string
        && d.get('name', '').size() > 0
        && d.get('name', '').size() <= 200
        && d.get('name', '').matches('.*\\S.*')
        && d.get('phone', null) is string
        && d.get('phone', '').size() >= 7
        && d.get('phone', '').size() <= 30
        && d.get('phone', '').matches('[0-9٠-٩+()\\- ]+')
        && optionalString(d, 'companyName', 200)
        && optionalString(d, 'secondaryPhone', 30)
        && optionalString(d, 'email', 200)
        && optionalString(d, 'address', 300)
        && optionalString(d, 'city', 120)
        && optionalString(d, 'notes', 2000);
    }

    // Suppliers: only editable content fields (+ updatedAt) may change.
    // Ownership fields (id / ownerId / shopId) and the create timestamp
    // are immutable from clients — no cross-shop reassignment.
    function onlySupplierEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'companyName', 'secondaryPhone',
          'email', 'address', 'city', 'notes', 'updatedAt']);
    }

    // Products: an optional supplier reference must point at a supplier
    // document that exists in the SAME shop, and supplierId/supplierName
    // are never mixed: both present (id + name snapshot) or both absent
    // (null/missing = no supplier, legacy docs ok).
    // Costs one exists() + one get() per product write.
    function validSupplierRef() {
      let sid = request.resource.data.get('supplierId', null);
      let sname = request.resource.data.get('supplierName', null);
      return (sid == null && sname == null)
        || (sid is string && sid != ''
          && sname is string && sname.size() <= 200
          && supplierInShop(sid, request.resource.data.get('shopId', null)));
    }

    // True only when the supplier doc exists and belongs to `shopId`.
    // `exists()` short-circuits the `get()` for missing docs.
    function supplierInShop(supplierId, shopId) {
      let ref = /databases/$(database)/documents/suppliers/$(supplierId);
      return shopId != null && shopId != ''
        && exists(ref)
        && get(ref).data.get('shopId', null) == shopId;
    }

    // ── الحسابات: قاعدة الأشخاص الموحّدة (عميل / مورد / الاثنين) ──
    //  - name + phone مطلوبان ومحدودان؛ الهاتف أرقام فقط (لاتينية أو
    //    عربية-هندية) مع علامات التوحيد المسموحة.
    //  - type محدود بالقيم الثلاث المعروفة.
    function validPerson(docId) {
      let d = request.resource.data;
      return d.get('id', null) == docId
        && d.get('ownerId', null) == myUid()
        && d.get('shopId', null) == myShopId()
        && d.get('name', null) is string
        && d.get('name', '').size() > 0
        && d.get('name', '').size() <= 200
        && d.get('name', '').matches('.*\\S.*')
        && d.get('phone', null) is string
        && d.get('phone', '').size() >= 7
        && d.get('phone', '').size() <= 30
        && d.get('phone', '').matches('[0-9٠-٩+()\\- ]+')
        && d.get('type', null) in ['customer', 'supplier', 'both'];
    }

    // تحديث الأشخاص: الاسم/الرقم/النوع/updatedAt فقط — الملكية ثابتة.
    function onlyPersonEditableFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'phone', 'type', 'normalizedPhone', 'updatedAt']);
    }

    // True only when the person doc exists and belongs to `shopId`.
    function personInShop(personId, shopId) {
      let ref = /databases/$(database)/documents/persons/$(personId);
      return personId is string && personId != ''
        && shopId != null && shopId != ''
        && exists(ref)
        && get(ref).data.get('shopId', null) == shopId;
    }

    // ── الحسابات: سجلات الذمم (debts) ─────────────────────
    //  - المبالغ أرقام موجبة، paidAmount لا يتجاوز amount.
    //  - العميل دائمًا direction=receivable — لا يمكن قلب اتجاهه.
    //  - personId يجب أن يشير لشخص في نفس المحل (نفس نمط validSupplierRef).
    function validDebt(docId) {
      let d = request.resource.data;
      return d.get('id', null) == docId
        && d.get('ownerId', null) == myUid()
        && d.get('shopId', null) == myShopId()
        && d.get('personId', null) is string
        && d.get('personId', '').size() > 0
        && d.get('personId', '').size() <= 128
        && d.get('personName', null) is string
        && d.get('personName', '').size() > 0
        && d.get('personName', '').size() <= 200
        && d.get('personName', '').matches('.*\\S.*')
        && optionalString(d, 'personPhone', 30)
        && d.get('partyType', null) in ['customer', 'supplier']
        && d.get('direction', null) in ['receivable', 'payable']
        && (d.get('partyType', null) == 'supplier'
            || d.get('direction', null) == 'receivable')
        && d.get('amount', null) is number
        && d.get('amount', 0) > 0
        && d.get('amount', 0) <= 1000000000
        && d.get('paidAmount', null) is number
        && d.get('paidAmount', 0) >= 0
        && d.get('paidAmount', 0) <= d.get('amount', 0)
        && optionalString(d, 'note', 2000)
        && optionalString(d, 'saleId', 128)
        && personInShop(d.get('personId', null), d.get('shopId', null));
    }

    // تحديث المديونية الوحيد المسموح من العميل: السداد عبر transaction.
    // paidAmount لا ينقص أبدًا ولا يتجاوز الأصل؛ بقية الحقول مجمّدة.
    function onlyDebtPaymentFields() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['paidAmount', 'updatedAt'])
        && request.resource.data.paidAmount is number
        && request.resource.data.paidAmount >= resource.data.paidAmount
        && request.resource.data.paidAmount <= resource.data.amount;
    }

    // Live subscription required for WRITES on business data.
    // A suspended shop is read-only no matter what the status/dates say.
    function subscriptionLive() {
      let sub = get(/databases/$(database)/documents/users/$(myUid())/subscription/current).data;
      return sub != null
        && sub.get('status', '') in ['trial', 'active']
        && sub.get('suspended', false) == false
        && sub.get('endDate', null) != null
        && sub.endDate > request.time;
    }

    function mayWriteShopData(shopId) {
      return isAdmin() || (sameShop(shopId) && subscriptionLive());
    }

    // ── users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());
      // Registration creates the owner doc (no role field on create).
      allow create: if signedIn() && myUid() == userId
        && request.resource.data.get('role', 'owner') == 'owner';
      // Owner edits own doc but can never touch `role` or any field
      // outside the profile allowlist; admin can do all.
      allow update: if isAdmin()
        || (signedIn() && myUid() == userId && unchangedRole()
          && onlyOwnerFields());
      allow delete: if false;
    }

    // ── users/{uid}/subscription/current ─────────────────────
    match /users/{userId}/subscription/{subId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());

      // The only thing a client may create is its own 7 day trial, once,
      // starting about now — never pre-suspended.
      allow create: if signedIn()
        && myUid() == userId
        && request.resource.data.status == 'trial'
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.isTrial == true
        && request.resource.data.trialStartDate >= request.time - duration.value(1, 'd')
        && request.resource.data.trialStartDate <= request.time + duration.value(1, 'd')
        && request.resource.data.trialEndDate <=
           request.resource.data.trialStartDate + duration.value(7, 'd');

      // Owner may move to expired / pending / rejected freely. Reaching
      // `active` requires the admin-approved request it points at.
      // `suspended` is admin-only: owners can never flip it either way.
      // Admin may write anything (approve / reject / suspend flows).
      allow update: if isAdmin() || (signedIn()
        && myUid() == userId
        && request.resource.data.get('suspended', false) ==
          resource.data.get('suspended', false)
        && (
             request.resource.data.status in ['expired', 'pending', 'rejected']
             || (
                  request.resource.data.status == 'active'
                  && request.resource.data.lastRequestId is string
                  && get(/databases/$(database)/documents/subscription_requests/$(request.resource.data.lastRequestId)).data.status == 'approved'
                )
           ));

      allow delete: if false;
    }

    // ── subscriptions mirror (admin dashboard reads) ─────────
    // Clients may only ever write non-active statuses (trial signup,
    // pending request, expiry). `active` comes exclusively from the admin
    // approval transaction — a user can no longer spoof an active plan.
    match /subscriptions/{userId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());
      allow create, update: if isAdmin() || (signedIn()
        && myUid() == userId
        && request.resource.data.get('status', '') in
          ['trial', 'pending', 'expired', 'rejected']);
      allow delete: if isAdmin();
    }

    // ── subscription requests ────────────────────────────────
    match /subscription_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == myUid() || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == myUid()
        && request.resource.data.status == 'pending'
        // Amount is NEVER trusted from the client: it must equal the price
        // the admin configured in `admin_settings/settings` for exactly the
        // selected plan (a tampered amount or a mismatched plan id — e.g.
        // amount: 1 for the yearly plan — is rejected before review).
        // The price fields are read with a `-1` default and `amount > 0`
        // guards the comparison, so a missing field can never be matched.
        // The `.get('…', -1)` calls short-circuit per plan branch, staying
        // well inside the 10 access-call budget per evaluation.
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && (
             // Preferred: validate against the live dashboard-configured price.
             (exists(/databases/$(database)/documents/admin_settings/settings)
               && (
                    (request.resource.data.selectedPlan == 'monthly'
                      && request.resource.data.amount ==
                        get(/databases/$(database)/documents/admin_settings/settings).data.get('monthlyPrice', -1))
                    || (request.resource.data.selectedPlan == 'threeMonths'
                      && request.resource.data.amount ==
                        get(/databases/$(database)/documents/admin_settings/settings).data.get('threeMonthsPrice', -1))
                    || (request.resource.data.selectedPlan == 'sixMonths'
                      && request.resource.data.amount ==
                        get(/databases/$(database)/documents/admin_settings/settings).data.get('sixMonthsPrice', -1))
                    || (request.resource.data.selectedPlan == 'yearly'
                      && request.resource.data.amount ==
                        get(/databases/$(database)/documents/admin_settings/settings).data.get('yearlyPrice', -1))
                  ))
             // Fallback: only if the settings doc does not exist yet, accept
             // the same built-in defaults the app ships with (still trusted
             // constants written here on the server, never client data).
             || (!exists(/databases/$(database)/documents/admin_settings/settings)
               && (
                    (request.resource.data.selectedPlan == 'monthly' && request.resource.data.amount == 99)
                    || (request.resource.data.selectedPlan == 'threeMonths' && request.resource.data.amount == 249)
                    || (request.resource.data.selectedPlan == 'sixMonths' && request.resource.data.amount == 449)
                    || (request.resource.data.selectedPlan == 'yearly' && request.resource.data.amount == 799)
                  ))
           )
        && request.resource.data.paymentMethod in
          ['instapay', 'vodafone_cash', 'etisalat_cash']
        && request.resource.data.paymentProofUrl.matches('https://.*');

      // Clients can never approve/reject their own rows — admin only.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── shops ────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn() && request.resource.data.ownerId == myUid();
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid());
      allow delete: if false;
    }

    // ── business data (subscription-gated writes) ────────────
    match /products/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && validProduct()
        && validSupplierRef()
        && mayWriteShopData(request.resource.data.shopId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid()
        && validProduct()
        && validSupplierRef()
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && mayWriteShopData(resource.data.shopId));
    }

    match /sales/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      // الفاتورة تشير اختياريًا لجهة اتصال (persons) في نفس المحل —
      // personId الفارغ (بيع عابر / فاتورة قديمة) لا يُطلب عنه شيء.
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('subtotal')
        && nonNegative('discount')
        && nonNegative('total')
        && optionalString(request.resource.data, 'personId', 128)
        && optionalString(request.resource.data, 'personName', 200)
        && optionalString(request.resource.data, 'personPhone', 30)
        && (request.resource.data.get('personId', '') == ''
            || personInShop(request.resource.data.personId,
                            request.resource.data.shopId))
        && mayWriteShopData(request.resource.data.shopId);
      // Sales are immutable from clients (returns are separate docs).
      allow update, delete: if isAdmin();
    }

    match /expenses/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('amount')
        && mayWriteShopData(request.resource.data.shopId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid()
        && nonNegative('amount')
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && mayWriteShopData(resource.data.shopId));
    }

    match /returns/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('total')
        && mayWriteShopData(request.resource.data.shopId);
      allow update, delete: if isAdmin();
    }

    // ── stock replenishment (purchase invoices) ──────────────
    // Accounting note: a purchase is inventory acquisition, NOT an
    // operating expense — it never writes to `expenses`.
    match /stock_purchases/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && nonNegative('totalAmount')
        && mayWriteShopData(request.resource.data.shopId);
      // Immutable from clients (audit trail), admin may fix records.
      allow update, delete: if isAdmin();
    }

    // One row per product stock change (movementType = 'purchase' now).
    match /stock_movements/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && request.resource.data.movementType == 'purchase'
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && nonNegative('previousStock')
        && nonNegative('newStock')
        && mayWriteShopData(request.resource.data.shopId);
      allow update, delete: if isAdmin();
    }

    // ── suppliers (الموردون) ─────────────────────────────────
    // Shop-scoped supplier directory: every query/write is limited to
    // the caller's own shop. Reads are open to the shop team, writes
    // require a live subscription (same rule as products).
    match /suppliers/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && validSupplier(docId)
        // Timestamps come from the server: nobody can back-date a supplier.
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && mayWriteShopData(request.resource.data.shopId);
      // Content edits only: ownerId/shopId/id/createdAt never move.
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && resource.data.shopId == request.resource.data.shopId
        && onlySupplierEditableFields()
        && validSupplier(docId)
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && mayWriteShopData(resource.data.shopId));
    }

    // ── persons (قاعدة الأشخاص الموحّدة) ─────────────────────
    // دليل موحّد للعملاء والموردين — نفس العزل والاشتراك كالموردين.
    match /persons/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && validPerson(docId)
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        && mayWriteShopData(request.resource.data.shopId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && resource.data.shopId == request.resource.data.shopId
        && onlyPersonEditableFields()
        && validPerson(docId)
        && mayWriteShopData(resource.data.shopId));
      // الحذف للأدمن فقط — الشخص مرتبط بسجلات ذمم تاريخية.
      allow delete: if isAdmin();
    }

    // ── debts (ذمم العملاء والموردين) ───────────────────────
    // السجل الأصلي لا يُحذف من العميل — يبقى كسجل تدقيق حتى بعد السداد.
    match /debts/{debtId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && validDebt(debtId)
        && request.resource.data.get('createdAt', null) == request.time
        && request.resource.data.get('updatedAt', null) == request.time
        // المديونية الجديدة تبدأ بلا مدفوعات.
        && request.resource.data.paidAmount == 0
        && mayWriteShopData(request.resource.data.shopId);
      // التعديل الوحيد: السداد (paidAmount/updatedAt) عبر transaction.
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && resource.data.shopId == request.resource.data.shopId
        && onlyDebtPaymentFields()
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin();

      // ── debts/{debtId}/payments (سجل حركات الدفع) ──────────
      // لا تُعدَّل ولا تُحذف — كل حركة مالية تبقى كما سُجِّلت.
      match /payments/{paymentId} {
        allow read: if signedIn() && (isAdmin()
          || get(/databases/$(database)/documents/debts/$(debtId)).data.ownerId == myUid()
          || sameShop(get(/databases/$(database)/documents/debts/$(debtId)).data.shopId));
        allow create: if signedIn()
          && request.resource.data.get('ownerId', null) == myUid()
          && request.resource.data.get('shopId', null) ==
             get(/databases/$(database)/documents/debts/$(debtId)).data.shopId
          && get(/databases/$(database)/documents/debts/$(debtId)).data.ownerId == myUid()
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          // الدفعة لا تتجاوز المتبقي الحالي للمديونية.
          && request.resource.data.amount <=
             get(/databases/$(database)/documents/debts/$(debtId)).data.amount
             - get(/databases/$(database)/documents/debts/$(debtId)).data.paidAmount
          && optionalString(request.resource.data, 'note', 2000)
          && request.resource.data.get('createdAt', null) == request.time
          && mayWriteShopData(request.resource.data.get('shopId', null));
        allow update, delete: if false;
      }
    }

    // ── feedback (contact us) ────────────────────────────────
    match /feedback/{docId} {
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── admin-only ───────────────────────────────────────────
    match /activity_logs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_settings/{docId} {
      // Customers read the settings (plan prices, trial days, wallet numbers)
      // so dashboard edits apply live; only admins may write.
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
