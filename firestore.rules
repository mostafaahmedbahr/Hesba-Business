rules_version = '2';

// Firestore security rules for Hesba — PRODUCTION version.
//
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase console > Firestore > Rules)
//
// Principles:
//  1. No catch-all: every collection is scoped explicitly. Default deny.
//  2. Shop isolation: a signed-in user touches only docs of their own shop
//     (ownerId match) or a shop they belong to (users/{uid}.shopId match,
//     so manager/cashier accounts of the same shop keep working).
//  3. Subscription enforcement is server-side, not just UI: creating,
//     updating or deleting business data (products/sales/expenses/returns)
//     requires a live trial/active subscription whose endDate is in the
//     future. Reads stay open (expired users can still VIEW their data).
//  4. Roles cannot be self-granted: `role` on users/{uid} can only change
//     via an existing admin (console). Owners keep `role` untouched.
//  5. Admin writes (approve/reject, dashboard mirrors, settings, activity)
//     are allowed through the `isAdmin()` check, so the Admin app works
//     with these rules deployed (the old draft blocked admin updates).
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function myUid() {
      return request.auth.uid;
    }

    function myUserDoc() {
      return get(/databases/$(database)/documents/users/$(myUid())).data;
    }

    function isAdmin() {
      return signedIn() && myUserDoc().get('role', '') == 'admin';
    }

    function myShopId() {
      return myUserDoc().get('shopId', '');
    }

    // Same shop: owner match, or a coworker account of the same shop.
    function sameShop(shopId) {
      return shopId != null && shopId != '' &&
        (myShopId() == shopId);
    }

    function unchangedRole() {
      return request.resource.data.get('role', null) ==
        resource.data.get('role', null);
    }

    // Owner-editable profile fields (updateProfile + FCM token only).
    // Anything else on users/{uid} (shopId, email, createdAt, …) is
    // admin-only, so a compromised client cannot escalate or reassign shops.
    function onlyOwnerFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['ownerName', 'phone', 'shopName', 'businessType',
          'shopPhone', 'address', 'state', 'city', 'shopImageUrl',
          'updatedAt', 'locationUrl', 'latitude', 'longitude',
          'locationAddress', 'fcmTokens', 'fcmTokensUpdatedAt']);
    }

    // Optional numeric field that, when present, must be a number >= 0.
    // Tolerant of partial updates; blocks negative-money injection.
    function nonNegative(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is number
          && request.resource.data[field] >= 0);
    }

    // Products: price is required and positive; everything else numeric
    // must stay >= 0 (stock 0 = out of stock is legitimate).
    function validProduct() {
      return request.resource.data.price is number
        && request.resource.data.price > 0
        && nonNegative('costPrice')
        && nonNegative('stock')
        && nonNegative('lowStockThreshold');
    }

    // Live subscription required for WRITES on business data.
    // A suspended shop is read-only no matter what the status/dates say.
    function subscriptionLive() {
      let sub = get(/databases/$(database)/documents/users/$(myUid())/subscription/current).data;
      return sub != null
        && sub.get('status', '') in ['trial', 'active']
        && sub.get('suspended', false) == false
        && sub.get('endDate', null) != null
        && sub.endDate > request.time;
    }

    function mayWriteShopData(shopId) {
      return isAdmin() || (sameShop(shopId) && subscriptionLive());
    }

    // ── users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());
      // Registration creates the owner doc (no role field on create).
      allow create: if signedIn() && myUid() == userId
        && request.resource.data.get('role', 'owner') == 'owner';
      // Owner edits own doc but can never touch `role` or any field
      // outside the profile allowlist; admin can do all.
      allow update: if isAdmin()
        || (signedIn() && myUid() == userId && unchangedRole()
          && onlyOwnerFields());
      allow delete: if false;
    }

    // ── users/{uid}/subscription/current ─────────────────────
    match /users/{userId}/subscription/{subId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());

      // The only thing a client may create is its own 7 day trial, once,
      // starting about now — never pre-suspended.
      allow create: if signedIn()
        && myUid() == userId
        && request.resource.data.status == 'trial'
        && request.resource.data.get('suspended', false) == false
        && request.resource.data.isTrial == true
        && request.resource.data.trialStartDate >= request.time - duration.value(1, 'd')
        && request.resource.data.trialStartDate <= request.time + duration.value(1, 'd')
        && request.resource.data.trialEndDate <=
           request.resource.data.trialStartDate + duration.value(7, 'd');

      // Owner may move to expired / pending / rejected freely. Reaching
      // `active` requires the admin-approved request it points at.
      // `suspended` is admin-only: owners can never flip it either way.
      // Admin may write anything (approve / reject / suspend flows).
      allow update: if isAdmin() || (signedIn()
        && myUid() == userId
        && request.resource.data.get('suspended', false) ==
          resource.data.get('suspended', false)
        && (
             request.resource.data.status in ['expired', 'pending', 'rejected']
             || (
                  request.resource.data.status == 'active'
                  && request.resource.data.lastRequestId is string
                  && get(/databases/$(database)/documents/subscription_requests/$(request.resource.data.lastRequestId)).data.status == 'approved'
                )
           ));

      allow delete: if false;
    }

    // ── subscriptions mirror (admin dashboard reads) ─────────
    // Clients may only ever write non-active statuses (trial signup,
    // pending request, expiry). `active` comes exclusively from the admin
    // approval transaction — a user can no longer spoof an active plan.
    match /subscriptions/{userId} {
      allow read: if signedIn() && (myUid() == userId || isAdmin());
      allow create, update: if isAdmin() || (signedIn()
        && myUid() == userId
        && request.resource.data.get('status', '') in
          ['trial', 'pending', 'expired', 'rejected']);
      allow delete: if isAdmin();
    }

    // ── subscription requests ────────────────────────────────
    match /subscription_requests/{requestId} {
      allow read: if signedIn()
        && (resource.data.userId == myUid() || isAdmin());

      allow create: if signedIn()
        && request.resource.data.userId == myUid()
        && request.resource.data.status == 'pending'
        // Amount is bound to the plan price — a tampered amount (e.g.
        // amount: 1 for the yearly plan) is rejected before review.
        && (
             (request.resource.data.selectedPlan == 'monthly' && request.resource.data.amount == 99)
             || (request.resource.data.selectedPlan == 'threeMonths' && request.resource.data.amount == 249)
             || (request.resource.data.selectedPlan == 'sixMonths' && request.resource.data.amount == 449)
             || (request.resource.data.selectedPlan == 'yearly' && request.resource.data.amount == 799)
           )
        && request.resource.data.paymentMethod in
          ['instapay', 'vodafone_cash', 'etisalat_cash']
        && request.resource.data.paymentProofUrl.matches('https://.*');

      // Clients can never approve/reject their own rows — admin only.
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ── shops ────────────────────────────────────────────────
    match /shops/{shopId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn() && request.resource.data.ownerId == myUid();
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid());
      allow delete: if false;
    }

    // ── business data (subscription-gated writes) ────────────
    match /products/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && validProduct()
        && mayWriteShopData(request.resource.data.shopId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid()
        && validProduct()
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && mayWriteShopData(resource.data.shopId));
    }

    match /sales/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('subtotal')
        && nonNegative('discount')
        && nonNegative('total')
        && mayWriteShopData(request.resource.data.shopId);
      // Sales are immutable from clients (returns are separate docs).
      allow update, delete: if isAdmin();
    }

    match /expenses/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('amount')
        && mayWriteShopData(request.resource.data.shopId);
      allow update: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && request.resource.data.ownerId == myUid()
        && nonNegative('amount')
        && mayWriteShopData(resource.data.shopId));
      allow delete: if isAdmin() || (signedIn()
        && resource.data.ownerId == myUid()
        && mayWriteShopData(resource.data.shopId));
    }

    match /returns/{docId} {
      allow read: if signedIn() && (isAdmin()
        || resource.data.ownerId == myUid()
        || sameShop(resource.data.shopId));
      allow create: if signedIn()
        && request.resource.data.ownerId == myUid()
        && nonNegative('total')
        && mayWriteShopData(request.resource.data.shopId);
      allow update, delete: if isAdmin();
    }

    // ── feedback (contact us) ────────────────────────────────
    match /feedback/{docId} {
      allow create: if signedIn()
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── admin-only ───────────────────────────────────────────
    match /activity_logs/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /admin_settings/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
